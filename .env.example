# ---------------------------------------------------------------------------
# Copy this file to `.env` before running the app:
#   macOS / Linux : cp .env.example .env
#   Windows (cmd) : copy .env.example .env
#   PowerShell    : Copy-Item .env.example .env
#
# Values below are the local-dev defaults and line up with docker-compose.yml.
# Full explanation of every var: claude/HLD.md §14.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Postgres. For the "everything in Docker" mode the host is `db`, not localhost:
#   DATABASE_URL=postgresql://ottodot:ottodot@db:5432/ottodot?schema=public
DATABASE_URL=postgresql://ottodot:ottodot@localhost:5432/ottodot?schema=public

# Redis (HTTP idempotency store only). Docker-compose mode: redis://redis:6379
REDIS_URL=redis://localhost:6379

# Mock payment — must stay true outside production; boot fails otherwise.
PAYMENT_MOCK_MODE=true
PAYMENT_MOCK_DELAY_MS=150          # artificial delay; widens the last-seat race window
PAYMENT_MOCK_FAIL_RATE=0           # 0..1, used only by simulatePayment=random (demo)

# Booking transaction / locking (HLD §6, D-Q1)
TX_TIMEOUT_MS=15000               # prisma.$transaction timeout + maxWait for the booking write
PG_LOCK_TIMEOUT_MS=3000            # SET lock_timeout per booking txn; raise to 10000 for local demo
PG_POOL_SIZE=20                    # Prisma connection_limit; must be >= the race test's N

# Idempotency (HLD §4, D-Q7)
IDEMPOTENCY_TTL_S=86400            # TTL for a completed ("done") key (Stripe convention)
IDEMPOTENCY_INPROGRESS_TTL_S=60    # TTL for an "in_progress" key so a crashed handler can't wedge it
IDEMPOTENCY_FAIL_MODE=open         # open = run handler if Redis is down; closed = 503

# Scalable reserve->pay->confirm flow only (HLD §7.1) — unused by the sync-mock build
# RESERVATION_TTL_MIN=10
