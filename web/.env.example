# Where the frontend sends API calls.
# Default: "/api" — Vite dev server proxies /api/* to http://localhost:3000.
# Alternative: talk to the API directly (CORS reflects any origin outside prod):
#   VITE_API_BASE=http://localhost:3000
VITE_API_BASE=/api

# Target the Vite dev proxy points /api at. Only used when VITE_API_BASE=/api.
VITE_PROXY_TARGET=http://localhost:3000
